# 이 파일을 복사해서 application-local.yml 로 만들고 비밀번호를 입력하세요
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/ScoutVelocity?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
    username: root
    password: [여기에_MySQL_비밀번호_입력]
    driver-class-name: com.mysql.cj.jdbc.Driver

  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect